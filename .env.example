PORT=
GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceaccount.json
SENTRY_DSN=
ALGOLIA_APP_ID=
# MUX_UPLOAD_CORS_ORIGIN=https://admin.the-tricktionary.com

# The project the secrets below are read from. Falls back to the project of the
# application default credentials, and to the metadata server on Cloud Run.
# GCP_PROJECT=

# Secrets come from Google Secret Manager, one secret per value, named exactly
# as below. Setting GSM_<name> here overrides the secret <name>, so local
# development doesn't need access to Secret Manager. Leave one blank or unset to
# read it from Secret Manager instead.
GSM_STRIPE_SK=
GSM_ALGOLIA_API_KEY=
GSM_MUX_TOKEN_ID=
GSM_MUX_TOKEN_SECRET=
GSM_MUX_WEBHOOK_SECRET=

# Only for regional secrets, which are for data residency. Leave unset for
# global secrets, which are readable from every region.
# GSM_LOCATION=europe-west1
