SENTRY_DSN=
ALGOLIA_APP_ID=
# MUX_UPLOAD_CORS_ORIGIN=https://admin.the-tricktionary.com
# TIMING_TRACK_BUCKET=tricktionary-timing-tracks
# ADMIN_URL=https://admin.the-tricktionary.com
# `report` only logs what the API client checks would refuse, see the README
# ACCESS_CONTROL=enforce

# The project the secrets below are read from and firestore is in.
GOOGLE_CLOUD_PROJECT=

# Secrets come from Google Secret Manager, one secret per value, named exactly
# as below. Setting GSM_<name> here overrides the secret <name>, so local
# development doesn't need access to Secret Manager. Leave one blank or unset to
# read it from Secret Manager instead.
GSM_tricktionary-api-stripe-sk=
GSM_tricktionary-api-algolia-api-key=
GSM_tricktionary-api-mux-token-id=
GSM_tricktionary-api-mux-token-secret=
GSM_tricktionary-api-mux-webhook-secret=
# Only read by the admin digest job, see the README
GSM_tricktionary-api-mailjet-api-key=
GSM_tricktionary-api-mailjet-secret-key=
