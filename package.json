{
  "name": "@the-tricktionary/api",
  "version": "1.0.0",
  "description": "GraphQL API for the Tricktionary",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.production.json",
    "dev": "tsx watch --clear-screen=false --import ./src/tracing.ts src/index.ts | pino-pretty",
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --fix",
    "typecheck": "tsc --noEmit",
    "codegen": "graphql-codegen --config codegen.yml",
    "codegen:watch": "npm run codegen -- --watch",
    "booklet:check": "tsx src/scripts/booklet-check.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/the-tricktionary/api.git"
  },
  "author": "the Tricktionary <contact@the-tricktionary.com> (https://the-tricktionary.com/)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/the-tricktionary/api/issues"
  },
  "homepage": "https://the-tricktionary.com",
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@apollo/utils.keyvaluecache": "^4.0.0",
    "@as-integrations/express5": "^1.1.2",
    "@cantoo/pdf-lib": "^2.11.1",
    "@google-cloud/firestore": "^7.11.6",
    "@google-cloud/secret-manager": "^7.1.0",
    "@google-cloud/storage": "^8.2.0",
    "@graphql-tools/merge": "^9.2.4",
    "@graphql-tools/schema": "^10.1.1",
    "@mux/mux-node": "^15.2.0",
    "@ropescore/rulesets": "^0.19.0",
    "@sentry/node": "^10.75.0",
    "@sentry/node-native": "^10.75.0",
    "@viz-js/viz": "^3.30.0",
    "algoliasearch": "^5.59.0",
    "apollo-datasource-firestore": "^6.4.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "firebase-admin": "^13.10.0",
    "graphql": "^16.11.0",
    "graphql-tag": "^2.12.7",
    "pino": "^10.3.1",
    "stripe": "^22.6.2",
    "zod": "^4.6.5",
    "zod-validation-error": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@graphql-codegen/add": "^7.1.0",
    "@graphql-codegen/cli": "^7.4.1",
    "@graphql-codegen/introspection": "^6.1.0",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-codegen/typescript-resolvers": "^6.1.0",
    "@parcel/watcher": "^2.6.0",
    "@tsconfig/node24": "^24.0.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.5",
    "eslint": "^9.39.5",
    "neostandard": "^0.13.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.13",
    "typescript": "6.0",
    "typescript-eslint": "^8.70.0"
  },
  "allowScripts": {
    "@apollo/protobufjs@1.2.8": true,
    "@firebase/util@1.15.3": true,
    "@parcel/watcher@2.6.0": true,
    "@sentry/node-native-stacktrace@0.5.2": true,
    "esbuild@0.28.2": true,
    "protobufjs@7.6.6": true
  }
}
